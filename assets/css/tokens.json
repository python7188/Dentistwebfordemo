{
  "color": {
    "primary": "#16a39d",
    "accent": "#ff6b61",
    "bg": "#f7faf9",
    "text": "#0b2b3b",
    "muted": "#6b7785",
    "white": "#ffffff",
    "shadow": "0 8px 24px rgba(11,43,59,0.08)",
    "shadow-hover": "0 16px 40px rgba(11,43,59,0.14)",
    "primary-light": "#e0f5f4",
    "accent-light": "#fff0ee",
    "overlay": "rgba(11,43,59,0.55)"
  },
  "typography": {
    "font-headline": "'Poppins', 'Inter var', sans-serif",
    "font-body": "'Inter', sans-serif",
    "weight-regular": 400,
    "weight-medium": 500,
    "weight-semibold": 600,
    "weight-bold": 700,
    "h1-desktop": "clamp(44px, 4vw, 56px)",
    "h1-tablet": "32px",
    "h1-mobile": "24px",
    "h2-desktop": "clamp(32px, 3vw, 40px)",
    "h3-desktop": "clamp(20px, 2vw, 24px)",
    "body-base": "16px",
    "body-line-height": 1.6,
    "small": "14px",
    "xsmall": "12px"
  },
  "spacing": {
    "xxs": "4px",
    "xs": "8px",
    "sm": "16px",
    "md": "24px",
    "lg": "32px",
    "xl": "48px",
    "xxl": "64px",
    "xxxl": "96px"
  },
  "grid": {
    "max-width-desktop": "1400px",
    "max-width-content": "1200px",
    "columns-desktop": 12,
    "columns-tablet": 8,
    "columns-mobile": 1,
    "gutter": "24px"
  },
  "animation": {
    "entrance-duration": "420ms",
    "entrance-delay": "120ms",
    "hover-duration": "240ms",
    "modal-duration": "320ms",
    "easing-entrance": "cubic-bezier(.22,.9,.28,1)",
    "easing-fade": "ease-in-out",
    "max-duration": "600ms"
  },
  "breakpoints": {
    "mobile": "480px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1400px"
  }
}
